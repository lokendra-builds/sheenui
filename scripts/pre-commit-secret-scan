#!/usr/bin/env python3
"""Block commits that contain secrets: key files, .env files, databases, or key-like values.

Local-only safety net. Copy it to .git/hooks/pre-commit with `bash scripts/install-git-hooks.sh`
(.git/hooks is never pushed, so every fresh clone installs it again).

Adapted from the owner's hook in urlpaste for a pnpm / Node project:
  - lockfiles (pnpm-lock.yaml, package-lock.json, yarn.lock, ...) are not content-scanned: their
    integrity hashes and long package names produce false positives;
  - the OpenAI-style `sk-` pattern needs a non-alphanumeric character before it, so words such as
    "task-runner-configuration" no longer match;
  - npm tokens and `_authToken=` lines in .npmrc are caught (a `${NPM_TOKEN}` placeholder is fine);
  - generated output (node_modules, dist, coverage, test-results) is never content-scanned.

Usage:
  scripts/pre-commit-secret-scan            scan what is staged (this is what git runs)
  scripts/pre-commit-secret-scan --all      scan every non-ignored file in the working tree
  scripts/pre-commit-secret-scan --self-test   check that the patterns fire on made-up samples
"""
import re
import subprocess
import sys

BLOCKED_FILES = re.compile(
    r"(^|/)("
    r"\.env(\..+)?"            # .env, .env.local, .env.production ...
    r"|.*\.(pem|key|p12|pfx|p8|ppk|jks|keystore)"
    r"|id_(rsa|dsa|ecdsa|ed25519)"
    r"|credentials\.json|service-account.*\.json"
    r"|secrets\.toml"
    r"|\.netrc"
    r"|.*\.(sqlite3?|db)(-journal|-wal|-shm)?"
    r")$"
)
ALLOWED_FILES = re.compile(r"(^|/)\.env\.example$")

# Never content-scanned: lockfiles (hashes, long names) and generated output.
SKIP_CONTENT = re.compile(
    r"(^|/)("
    r"pnpm-lock\.yaml|package-lock\.json|npm-shrinkwrap\.json|yarn\.lock|bun\.lockb?"
    r")$"
    r"|(^|/)(node_modules|dist|dist-ssr|coverage|test-results|playwright-report)/"
)

SECRET_PATTERNS = {
    "AWS access key": r"AKIA[0-9A-Z]{16}",
    "GitHub token": r"(ghp|gho|ghu|ghs|ghr)_[A-Za-z0-9]{36}|github_pat_[A-Za-z0-9_]{50,}",
    "OpenAI key": r"(?<![A-Za-z0-9])sk-(proj-)?[A-Za-z0-9_-]{20,}",
    "Anthropic key": r"sk-ant-[A-Za-z0-9_-]{20,}",
    "Google API key": r"AIza[0-9A-Za-z_-]{35}",
    "Slack token": r"xox[baprs]-[A-Za-z0-9-]{10,}",
    "Stripe key": r"(sk|rk)_live_[A-Za-z0-9]{20,}",
    "npm token": r"(?<![A-Za-z0-9])npm_[A-Za-z0-9]{36}",
    "npm auth line": r"_authToken\s*=\s*(?!\$\{)[^\s$]{8,}",
    "Private key": r"-----BEGIN [A-Z ]*PRIVATE KEY-----",
    "Hardcoded secret": r"(?i)\b(api[_-]?key|secret[_-]?key|secret|token|passwd|password)\b\s*[:=]\s*['\"][^'\"\s]{12,}['\"]",
}

MAX_FILE_BYTES = 2_000_000  # --all mode: skip anything larger (images, bundles)


def git(*args):
    return subprocess.run(["git", *args], capture_output=True, text=True, check=True).stdout


def scan_lines(path, lines, problems):
    """Add a problem for every line of `path` that matches a secret pattern."""
    if SKIP_CONTENT.search(path):
        return
    for line in lines:
        for name, pattern in SECRET_PATTERNS.items():
            if re.search(pattern, line):
                problems.append(f"{path}: looks like a {name}: {line.strip()[:80]}")


def scan_staged(problems):
    staged = [f for f in git("diff", "--cached", "--name-only", "-z", "--diff-filter=ACMR").split("\0") if f]
    for path in staged:
        if BLOCKED_FILES.search(path) and not ALLOWED_FILES.search(path):
            problems.append(f"{path}: secret/database file must not be committed")

    diff = git("diff", "--cached", "-U0", "--diff-filter=ACMR")
    current = None
    for line in diff.splitlines():
        if line.startswith("+++ b/"):
            current = line[6:]
        elif line.startswith("+++"):
            current = None  # /dev/null or a binary file
        elif line.startswith("+") and current:
            scan_lines(current, [line[1:]], problems)


def scan_tree(problems):
    names = git("ls-files", "-z", "--cached", "--others", "--exclude-standard").split("\0")
    for path in (n for n in names if n):
        if BLOCKED_FILES.search(path) and not ALLOWED_FILES.search(path):
            problems.append(f"{path}: secret/database file must not be committed")
            continue
        if SKIP_CONTENT.search(path):
            continue
        try:
            with open(path, "rb") as handle:
                data = handle.read(MAX_FILE_BYTES + 1)
        except OSError:
            continue
        if len(data) > MAX_FILE_BYTES or b"\0" in data:
            continue
        scan_lines(path, data.decode("utf-8", "replace").splitlines(), problems)


def self_test():
    """Every pattern must fire on a made-up sample (built at run time so this file stays clean)."""
    samples = {
        "AWS access key": "AKIA" + "A" * 16,
        "GitHub token": "ghp_" + "a" * 36,
        "OpenAI key": " sk-" + "a" * 24,
        "Anthropic key": "sk-ant-" + "a" * 24,
        "Google API key": "AIza" + "a" * 35,
        "Slack token": "xoxb-" + "1" * 12,
        "Stripe key": "sk_live_" + "a" * 24,
        "npm token": " npm_" + "a" * 36,
        "npm auth line": "//registry.npmjs.org/:_authToken=" + "a" * 20,
        "Private key": "-----BEGIN RSA " + "PRIVATE KEY-----",
        "Hardcoded secret": 'const password = "' + "a" * 14 + '"',
    }
    failed = [n for n, s in samples.items() if not re.search(SECRET_PATTERNS[n], s)]
    clean = ["task-runner-configuration-manager", "//registry.npmjs.org/:_authToken=${NPM_TOKEN}", "you@example.com"]
    failed += [f"false positive: {c}" for c in clean if any(re.search(p, c) for p in SECRET_PATTERNS.values())]
    files_ok = BLOCKED_FILES.search(".env.local") and not BLOCKED_FILES.search("src/env.ts") and ALLOWED_FILES.search(".env.example")
    if not files_ok:
        failed.append("file-name rules")
    if failed:
        print("secret-scan self-test FAILED: " + ", ".join(failed), file=sys.stderr)
        return 1
    print("secret-scan self-test passed")
    return 0


def main():
    if "--self-test" in sys.argv:
        return self_test()

    problems = []
    if "--all" in sys.argv:
        scan_tree(problems)
    else:
        scan_staged(problems)

    if problems:
        print("\nCommit blocked: possible secrets found\n", file=sys.stderr)
        for p in problems:
            print(f"  - {p}", file=sys.stderr)
        print(
            "\nRemove them from the commit (git restore --staged <file>), keep secrets in .env "
            "or environment variables, and never push keys. If a real secret was ever committed, "
            "rotate it: deleting it from history is not enough.\n",
            file=sys.stderr,
        )
        return 1
    return 0


if __name__ == "__main__":
    sys.exit(main())
