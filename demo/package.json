{
  "name": "demo",
  "version": "0.1.0",
  "private": true,
  "description": "The SheenUI docs and demo site (Vite + React 19, prerendered, deployed to GitHub Pages).",
  "keywords": [
    "sheenui",
    "react",
    "design-system",
    "documentation",
    "vite",
    "tailwindcss",
    "glassmorphism"
  ],
  "license": "MIT",
  "author": "Lokendra Singh Rathore",
  "homepage": "https://lokendra-builds.github.io/sheenui",
  "bugs": {
    "url": "https://github.com/lokendra-builds/sheenui/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/lokendra-builds/sheenui.git",
    "directory": "demo"
  },
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "node scripts/gen-props.mjs && node scripts/gen-page-dates.mjs && node ../scripts/build-registry.mjs && vite build && vite build --ssr src/entry-server.tsx --outDir dist-ssr && node scripts/prerender.mjs",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit && tsc --noEmit -p tsconfig.e2e.json",
    "og:build": "node scripts/og-images.mjs",
    "docs:check": "node scripts/docs-check.mjs",
    "docs:props": "node scripts/gen-props.mjs && node scripts/gen-page-dates.mjs",
    "seo:check": "node scripts/seo-check.mjs",
    "seo:smoke": "node scripts/smoke.mjs",
    "seo:console": "node scripts/console-check.mjs",
    "seo:hosting": "node scripts/hosting-check.mjs",
    "seo:lighthouse": "node scripts/lighthouse.mjs",
    "seo:verify": "pnpm build && pnpm seo:check && pnpm seo:smoke && pnpm seo:lighthouse",
    "e2e": "playwright test",
    "e2e:chromium": "E2E_SKIP_TIMING=1 playwright test --project chromium",
    "e2e:motion": "playwright test e2e/motion-gates.spec.ts --project chromium --workers=1",
    "e2e:sweep": "playwright test e2e/sweep.spec.ts --project chromium",
    "e2e:visual": "playwright test e2e/visual.spec.ts",
    "budget": "node scripts/budget.mjs && node scripts/budget-measure.mjs",
    "budget:initial": "node scripts/budget.mjs",
    "budget:measure": "node scripts/budget-measure.mjs",
    "bundle:stats": "node scripts/bundle-stats.mjs",
    "perf": "node scripts/perf.mjs"
  },
  "dependencies": {
    "@hookform/resolvers": "^7.0.9",
    "@sheenui/theme": "workspace:*",
    "motion": "^14.14.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-hook-form": "^7.92.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.14.1",
    "@fontsource-variable/geist": "5.3.0",
    "@fontsource-variable/geist-mono": "5.3.0",
    "@fontsource-variable/inter": "5.3.0",
    "@fontsource-variable/inter-tight": "5.3.0",
    "@fontsource-variable/jetbrains-mono": "5.3.0",
    "@fontsource/instrument-serif": "5.3.0",
    "@fontsource/inter": "5.3.0",
    "@playwright/test": "1.65.1",
    "@tailwindcss/vite": "^4.3.5",
    "@types/node": "26.6.7",
    "@types/react": "^19.3.1",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.3.0",
    "axe-core": "4.14.1",
    "lighthouse": "^13.6.0",
    "node-html-parser": "9.0.7",
    "postcss": "^8.5.33",
    "satori": "0.63.2",
    "sharp": "0.35.5",
    "tailwindcss": "^4.3.5",
    "typescript": "^7.0.2",
    "vite": "^8.3.8"
  }
}
