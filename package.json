{
  "name": "sheenui-workspace",
  "private": true,
  "description": "SheenUI monorepo: the @sheenui/theme component library and its docs site (demo).",
  "keywords": [
    "react",
    "react-components",
    "ui-library",
    "design-system",
    "tailwindcss",
    "glassmorphism",
    "liquid-glass",
    "base-ui",
    "motion",
    "charts",
    "shadcn"
  ],
  "license": "MIT",
  "author": "Lokendra Singh Rathore",
  "homepage": "https://lokendra-builds.github.io/sheenui",
  "bugs": {
    "url": "https://github.com/lokendra-builds/sheenui/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/lokendra-builds/sheenui.git"
  },
  "type": "module",
  "packageManager": "pnpm@11.0.4",
  "scripts": {
    "dev": "pnpm --filter demo dev",
    "build": "pnpm --filter demo build",
    "preview": "pnpm --filter demo preview",
    "typecheck": "pnpm -r typecheck",
    "lint": "eslint . --max-warnings 0",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "generated:check": "node demo/scripts/gen-props.mjs --check && node demo/scripts/gen-page-dates.mjs --check && node scripts/check-registry.mjs --skip-cli && node scripts/readme-index.mjs --check",
    "lint:report": "eslint . --format json --output-file test-results/eslint.json",
    "test": "pnpm --filter @sheenui/theme test",
    "test:coverage": "pnpm --filter @sheenui/theme test:coverage",
    "e2e": "pnpm --filter demo e2e",
    "e2e:chromium": "pnpm --filter demo e2e:chromium",
    "e2e:motion": "pnpm --filter demo e2e:motion",
    "e2e:sweep": "pnpm --filter demo e2e:sweep",
    "e2e:visual": "pnpm --filter demo e2e:visual",
    "e2e:visual:update": "pnpm --filter demo exec playwright test e2e/visual.spec.ts --update-snapshots=all",
    "e2e:install": "pnpm --filter demo exec playwright install chromium webkit firefox",
    "copy-test": "node scripts/copy-test.mjs",
    "registry:build": "node scripts/build-registry.mjs",
    "registry:check": "node scripts/check-registry.mjs",
    "registry:check:fast": "node scripts/check-registry.mjs --skip-cli",
    "package:check": "node scripts/check-package.mjs",
    "treeshake:check": "node scripts/check-treeshake.mjs",
    "outdated:check": "node scripts/check-outdated.mjs",
    "scripts:test": "node --test scripts/test/*.test.mjs",
    "seo:check": "pnpm --filter demo seo:check",
    "readme:index": "node scripts/readme-index.mjs",
    "docs:props": "node demo/scripts/gen-props.mjs && node demo/scripts/gen-page-dates.mjs",
    "docs:check": "pnpm --filter demo docs:check",
    "budget": "pnpm --filter demo budget",
    "perf": "pnpm --filter demo perf",
    "examples:check": "node scripts/check-examples.mjs --strict",
    "pagecode:check": "node scripts/check-page-code.mjs && node scripts/check-guide-code.mjs",
    "motion:literals": "node scripts/check-motion-literals.mjs",
    "motion:properties": "node scripts/check-motion-properties.mjs",
    "types:check": "node scripts/check-prop-types.mjs",
    "verify": "pnpm generated:check && pnpm outdated:check && pnpm format:check && pnpm motion:literals && pnpm motion:properties && pnpm typecheck && pnpm lint && pnpm test:coverage && pnpm build && pnpm package:check && pnpm treeshake:check && pnpm seo:check && pnpm docs:check && pnpm readme:index --check && pnpm budget && pnpm examples:check && pnpm types:check && pnpm e2e:chromium && pnpm e2e:motion"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "eslint": "10.15.0",
    "eslint-plugin-jsdoc": "65.4.9",
    "eslint-plugin-jsx-a11y": "6.10.2",
    "eslint-plugin-react-hooks": "7.1.1",
    "globals": "17.14.0",
    "prettier": "3.10.1",
    "typescript": "6.0.3",
    "typescript-eslint": "8.72.2"
  }
}
