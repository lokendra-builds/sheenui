{
  "name": "@sheenui/theme",
  "version": "0.1.0",
  "private": true,
  "description": "SheenUI: a glassy, classy React theme with motion. Copy the components you need.",
  "keywords": [
    "react",
    "react-components",
    "ui-library",
    "design-system",
    "tailwindcss",
    "tailwind-v4",
    "glassmorphism",
    "liquid-glass",
    "base-ui",
    "motion",
    "charts",
    "dashboard",
    "shadcn",
    "nextjs",
    "typescript"
  ],
  "license": "MIT",
  "author": "Lokendra Singh Rathore",
  "homepage": "https://lokendra-builds.github.io/sheenui",
  "bugs": {
    "url": "https://github.com/lokendra-builds/sheenui/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/lokendra-builds/sheenui.git",
    "directory": "theme"
  },
  "type": "module",
  "sideEffects": [
    "**/*.css"
  ],
  "exports": {
    ".": "./src/index.ts",
    "./demo-data": "./src/demo-data.ts",
    "./styles.css": "./src/styles/index.css",
    "./styles/*": "./src/styles/*",
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "publishConfig": {
    "access": "public",
    "main": "./dist/index.js",
    "module": "./dist/index.js",
    "types": "./dist/index.d.ts",
    "exports": {
      ".": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "./demo-data": {
        "types": "./dist/demo-data.d.ts",
        "default": "./dist/demo-data.js"
      },
      "./components/*": {
        "types": "./dist/components/*.d.ts",
        "default": "./dist/components/*.js"
      },
      "./blocks/*": {
        "types": "./dist/blocks/*.d.ts",
        "default": "./dist/blocks/*.js"
      },
      "./motion/*": {
        "types": "./dist/motion/*.d.ts",
        "default": "./dist/motion/*.js"
      },
      "./hooks/*": {
        "types": "./dist/hooks/*.d.ts",
        "default": "./dist/hooks/*.js"
      },
      "./styles.css": {
        "types": "./dist/styles.d.ts",
        "default": "./dist/styles/index.css"
      },
      "./styles/*": "./dist/styles/*",
      "./package.json": "./package.json"
    }
  },
  "scripts": {
    "build": "node scripts/build.mjs",
    "prepack": "node scripts/build.mjs",
    "typecheck": "tsc --noEmit && tsc --noEmit -p tsconfig.test.json",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage"
  },
  "peerDependencies": {
    "@base-ui/react": "^1.9.0",
    "@types/react": "^19.0.0",
    "motion": "^14.10.1",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "tailwindcss": "^4.1.0"
  },
  "peerDependenciesMeta": {
    "@types/react": {
      "optional": true
    }
  },
  "dependencies": {
    "@tanstack/react-table": "^9.3.1",
    "clsx": "^2.1.1",
    "tailwind-merge": "^3.7.0"
  },
  "devDependencies": {
    "@base-ui/react": "^1.9.0",
    "@hookform/resolvers": "^7.0.6",
    "@tailwindcss/vite": "4.3.5",
    "@testing-library/dom": "10.4.2",
    "@testing-library/jest-dom": "7.0.1",
    "@testing-library/react": "16.3.3",
    "@testing-library/user-event": "14.6.12",
    "@types/node": "26.6.6",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "6.3.0",
    "@vitest/browser-playwright": "5.1.0",
    "@vitest/coverage-v8": "5.1.0",
    "axe-core": "4.14.1",
    "motion": "^14.14.0",
    "playwright": "1.65.1",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-hook-form": "^7.92.0",
    "tailwindcss": "4.3.5",
    "typescript": "^7.0.2",
    "vite": "8.3.8",
    "vitest": "5.1.0",
    "zod": "^4.6.7"
  }
}
